{
  "$schema": "OPD Visit / Registration entity",
  "entity": "OPDVisit",
  "fields": [
    { "name": "visitId", "type": "string", "autoGenerated": true },
    { "name": "patientId", "type": "uuid", "required": true },
    { "name": "clinicId", "type": "integer", "required": true },
    { "name": "opdType", "type": "string", "required": true },
    { "name": "modalityType", "type": "string" },
    { "name": "doctorId", "type": "integer", "required": true },
    { "name": "roomNo", "type": "string" },
    { "name": "referredBy", "type": "string", "required": true },
    { "name": "reason", "type": "string", "required": true },
    { "name": "feeStructureId", "type": "integer", "required": true },
    { "name": "totalFee", "type": "decimal", "currency": "INR" },
    { "name": "paymentCollected", "type": "boolean", "default": false },
    { "name": "visitDate", "type": "datetime" },
    { "name": "status", "type": "enum", "options": ["registered", "in_queue", "with_doctor", "completed", "cancelled"] },
    { "name": "isMLC", "type": "boolean", "default": false },
    { "name": "mlcDetails", "type": "MLCDetails", "nullable": true }
  ],
  "queueActions": ["check_in", "assign_doctor", "complete", "refer", "cancel"],
  "relatedPages": ["patientRegistrationOPD.php", "accidentEmergencyQueueNew.php"]
}
