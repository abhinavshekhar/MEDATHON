# ─── Next.js / Prisma (required) ───────────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# ─── Public app URLs (Vercel production) ───────────────────────────────────
NEXT_PUBLIC_APP_URL="https://medathon-ten.vercel.app"
NEXT_PUBLIC_APP_NAME="MEDATHON"

# AI radiology runs on Next.js by default in production.
# Set to https://medathon-ten.vercel.app on Vercel, or http://localhost:8000 for local FastAPI.
NEXT_PUBLIC_AI_API_URL="https://medathon-ten.vercel.app"

# Optional: external FastAPI (Render) for WebSocket vitals / ESP32 forwarding
# AI_API_URL="https://medathon-ai-api.onrender.com"
